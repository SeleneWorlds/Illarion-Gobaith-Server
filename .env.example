# Paste each complete multiline private key, including BEGIN/END lines.
# In a local .env file, enclose each multiline value in single quotes.
GOBAITH_DATA_DEPLOY_KEY=
GOBAITH_SCRIPTS_DEPLOY_KEY=
GOBAITH_DATA_GIT_AUTHOR_NAME=Selene Server
GOBAITH_DATA_GIT_AUTHOR_EMAIL=noreply@seleneworlds.com
GOBAITH_DATA_SYNC_INTERVAL_SECONDS=300
# Empty branch settings use each remote's default branch on first clone.
GOBAITH_DATA_GIT_BRANCH=
GOBAITH_SCRIPTS_GIT_BRANCH=
GOBAITH_SCRIPTS_WEBHOOK_SECRET=
